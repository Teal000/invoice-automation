# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
# PostgreSQL connection (local Postgres 18 install; see docs/setup.md)
# ---------------------------------------------------------------------------
INVAUT_DB_HOST=localhost
INVAUT_DB_PORT=5432
INVAUT_DB_NAME=invoice_automation
INVAUT_DB_USER=invoice_app
INVAUT_DB_PASSWORD=change_me
# Separate database used by the integration tests; it is dropped and recreated.
INVAUT_TEST_DB_NAME=invoice_automation_test

# ---------------------------------------------------------------------------
# Money and validation configuration (fictional test values, not tax guidance)
# ---------------------------------------------------------------------------
# TND is subdivided into 1000 millimes, so amounts carry three decimal places.
INVAUT_CURRENCY=TND
INVAUT_MONEY_DECIMAL_PLACES=3
# Rounding applied when normalising extracted amounts.
INVAUT_MONEY_ROUNDING=ROUND_HALF_UP
# Absolute tolerance for arithmetic reconciliation, in currency units.
INVAUT_ARITHMETIC_TOLERANCE=0.001
# Purchase-order amount tolerance: a difference passes if it is within either.
INVAUT_PO_ABSOLUTE_TOLERANCE=1.000
INVAUT_PO_RELATIVE_TOLERANCE=0.02
# Fictional configured tax rate used by the fixture generator, not a tax rule.
INVAUT_CONFIGURED_TAX_RATE=0.19

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
INVAUT_STORAGE_ROOT=data/storage
