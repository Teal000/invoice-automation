        <bpmndi:BPMNLabel>
          <dc:Bounds x="1201" y="227" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_pass_yes_di" bpmnElement="f_pass_yes">
        <di:waypoint x="1370" y="245" />
        <di:waypoint x="1502" y="245" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1376" y="227" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_pass_no_di" bpmnElement="f_pass_no">
        <di:waypoint x="1345" y="270" />
        <di:waypoint x="1345" y="575" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1351" y="274" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_fail_di" bpmnElement="f_fail">
        <di:waypoint x="610" y="303" />
