<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_to_be" targetNamespace="https://github.com/Teal000/invoice-automation" exporter="tools/build_process_maps.py" exporterVersion="1">
  <bpmn:collaboration id="Collaboration_to_be">
    <bpmn:documentation>Supplier invoices with the service (to-be, as built). Generated from tools/build_process_maps.py; edit the spec there, not this file.</bpmn:documentation>
    <bpmn:participant id="P_supplier" name="Supplier" />
    <bpmn:participant id="P_distributor" name="Distributor" processRef="Process_to_be" />
    <bpmn:messageFlow id="M_invoice" name="Invoice PDF" sourceRef="P_supplier" targetRef="s_up" />
  </bpmn:collaboration>
  <bpmn:process id="Process_to_be" isExecutable="false">
    <bpmn:laneSet id="LaneSet_to_be">
      <bpmn:lane id="L_service" name="Invoice service (API + n8n)">
        <bpmn:flowNodeRef>s_up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_sup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_dup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_unsup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_retry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_reviewer" name="Reviewer">
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rej</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_finance" name="Finance manager">
        <bpmn:flowNodeRef>s_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_up" name="Invoice PDF uploaded">
      <bpmn:outgoing>f_up</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_up_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_store" name="Store the file and record the arrival">
      <bpmn:incoming>f_up</bpmn:incoming>
      <bpmn:outgoing>f_store</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_extract" name="Extract header and line values">
      <bpmn:incoming>f_store</bpmn:incoming>
      <bpmn:incoming>f_retry</bpmn:incoming>
      <bpmn:outgoing>f_extract</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="b_fail" name="Technical failure" attachedToRef="t_extract">
      <bpmn:outgoing>f_fail</bpmn:outgoing>
      <bpmn:errorEventDefinition id="b_fail_def" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="t_rules" name="Run the 13 validation rules">
      <bpmn:incoming>f_extract</bpmn:incoming>
      <bpmn:incoming>f_recheck</bpmn:incoming>
      <bpmn:outgoing>f_rules</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_dup" name="Exact copy of a file already received?">
      <bpmn:incoming>f_rules</bpmn:incoming>
      <bpmn:outgoing>f_dup_yes</bpmn:outgoing>
      <bpmn:outgoing>f_dup_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_sup" name="Supported document?">
      <bpmn:incoming>f_dup_no</bpmn:incoming>
      <bpmn:outgoing>f_sup_no</bpmn:outgoing>
      <bpmn:outgoing>f_sup_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_pass" name="Every check passed?">
      <bpmn:incoming>f_sup_yes</bpmn:incoming>
      <bpmn:outgoing>f_pass_yes</bpmn:outgoing>
      <bpmn:outgoing>f_pass_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_valid" name="Validated, in the register">
      <bpmn:incoming>f_pass_yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_link" name="Link to the earlier invoice">
      <bpmn:incoming>f_dup_yes</bpmn:incoming>
      <bpmn:outgoing>f_link</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_dup" name="No second invoice created">
      <bpmn:incoming>f_link</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e_unsup" name="Recorded as unsupported">
      <bpmn:incoming>f_sup_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_retry" name="Keep the job; the recovery sweep retries it">
      <bpmn:incoming>f_fail</bpmn:incoming>
      <bpmn:outgoing>f_retry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_review" name="Review the failed checks">
      <bpmn:incoming>f_pass_no</bpmn:incoming>
      <bpmn:outgoing>f_review</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_dec" name="Decision">
      <bpmn:incoming>f_review</bpmn:incoming>
      <bpmn:outgoing>f_correct</bpmn:outgoing>
      <bpmn:outgoing>f_accept</bpmn:outgoing>
      <bpmn:outgoing>f_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_correct" name="Enter the corrected values and a reason">
      <bpmn:incoming>f_correct</bpmn:incoming>
      <bpmn:outgoing>f_recheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_accept" name="Accept as an exception, with a reason">
      <bpmn:incoming>f_accept</bpmn:incoming>
      <bpmn:outgoing>f_accepted</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_acc" name="In the register, marked as an exception">
      <bpmn:incoming>f_accepted</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t_reject" name="Reject, with a reason">
      <bpmn:incoming>f_reject</bpmn:incoming>
      <bpmn:outgoing>f_rejected</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_rej" name="Rejected; the invoice number is released">
      <bpmn:incoming>f_rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s_fin" name="Figures needed">
      <bpmn:outgoing>f_fin</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_dash" name="Read the Power BI dashboard">
      <bpmn:incoming>f_fin</bpmn:incoming>
      <bpmn:outgoing>f_dash</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_fin" name="Figures that reconcile to the records">
      <bpmn:incoming>f_dash</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_up" sourceRef="s_up" targetRef="t_store" />
    <bpmn:sequenceFlow id="f_store" sourceRef="t_store" targetRef="t_extract" />
    <bpmn:sequenceFlow id="f_extract" sourceRef="t_extract" targetRef="t_rules" />
    <bpmn:sequenceFlow id="f_rules" sourceRef="t_rules" targetRef="g_dup" />
    <bpmn:sequenceFlow id="f_dup_yes" name="Yes" sourceRef="g_dup" targetRef="t_link" />
    <bpmn:sequenceFlow id="f_dup_no" name="No" sourceRef="g_dup" targetRef="g_sup" />
    <bpmn:sequenceFlow id="f_link" sourceRef="t_link" targetRef="e_dup" />
    <bpmn:sequenceFlow id="f_sup_no" name="No" sourceRef="g_sup" targetRef="e_unsup" />
    <bpmn:sequenceFlow id="f_sup_yes" name="Yes" sourceRef="g_sup" targetRef="g_pass" />
    <bpmn:sequenceFlow id="f_pass_yes" name="Yes" sourceRef="g_pass" targetRef="e_valid" />
    <bpmn:sequenceFlow id="f_pass_no" name="No" sourceRef="g_pass" targetRef="t_review" />
    <bpmn:sequenceFlow id="f_fail" sourceRef="b_fail" targetRef="t_retry" />
    <bpmn:sequenceFlow id="f_retry" name="Retried" sourceRef="t_retry" targetRef="t_extract" />
    <bpmn:sequenceFlow id="f_review" sourceRef="t_review" targetRef="g_dec" />
    <bpmn:sequenceFlow id="f_correct" name="Correct" sourceRef="g_dec" targetRef="t_correct" />
    <bpmn:sequenceFlow id="f_recheck" name="Checked again by the same rules" sourceRef="t_correct" targetRef="t_rules" />
    <bpmn:sequenceFlow id="f_accept" name="Accept" sourceRef="g_dec" targetRef="t_accept" />
    <bpmn:sequenceFlow id="f_accepted" sourceRef="t_accept" targetRef="e_acc" />
    <bpmn:sequenceFlow id="f_reject" name="Reject" sourceRef="g_dec" targetRef="t_reject" />
    <bpmn:sequenceFlow id="f_rejected" sourceRef="t_reject" targetRef="e_rej" />
    <bpmn:sequenceFlow id="f_fin" sourceRef="s_fin" targetRef="t_dash" />
    <bpmn:sequenceFlow id="f_dash" sourceRef="t_dash" targetRef="e_fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_to_be">
    <bpmndi:BPMNPlane id="Plane_to_be" bpmnElement="Collaboration_to_be">
      <bpmndi:BPMNShape id="P_supplier_di" bpmnElement="P_supplier" isHorizontal="true">
        <dc:Bounds x="150" y="30" width="1845" height="70" />
